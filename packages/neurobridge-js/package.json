{
  "name": "neurobridge",
  "version": "0.2.0-beta.1",
  "description": "Cognitive accessibility middleware for AI output (JavaScript/TypeScript SDK)",
  "license": "MIT",
  "type": "module",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    },
    "./browser": {
      "import": "./dist/browser/neurobridge.global.js",
      "default": "./dist/browser/neurobridge.global.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.24.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^22.13.10",
    "rimraf": "^6.0.1",
    "rollup": "^4.21.2",
    "tslib": "^2.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdilShamim8/NeuroBridge.git",
    "directory": "packages/neurobridge-js"
  },
  "author": "Adil Shamim",
  "bugs": {
    "url": "https://github.com/AdilShamim8/NeuroBridge/issues"
  },
  "homepage": "https://github.com/AdilShamim8/NeuroBridge#readme",
  "keywords": [
    "accessibility",
    "neurodiversity",
    "llm",
    "middleware",
    "ai",
    "text-transformation"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
