# Core library
NEUROBRIDGE_MEMORY_BACKEND=sqlite        # sqlite | redis | none
NEUROBRIDGE_MEMORY_PATH=~/.neurobridge/memory.db
NEUROBRIDGE_DEBUG=false
NEUROBRIDGE_FEEDBACK_LEARNING=true
NEUROBRIDGE_CACHE_PROFILES=true
NEUROBRIDGE_OUTPUT_FORMAT=markdown       # markdown | html | plain | json | tts
NEUROBRIDGE_MAX_CHUNK_WORDS=80
NEUROBRIDGE_AUTO_ADJUST_AFTER=10
NEUROBRIDGE_MAX_TEXT_LENGTH=50000
NEUROBRIDGE_REDIS_URL=redis://localhost:6379/0

# REST API server (neurobridge serve; requires pip install ".[server]")
NEUROBRIDGE_ALLOWED_ORIGINS=*            # comma-separated origin list; avoid * with credentials
NEUROBRIDGE_API_KEY=                     # set to enable Bearer auth on the API
NEUROBRIDGE_RATE_LIMIT_PER_MINUTE=60
NEUROBRIDGE_API_KEY_RATE_LIMIT_PER_MINUTE=120
NEUROBRIDGE_MAX_REQUEST_SIZE_BYTES=1048576
NEUROBRIDGE_REQUEST_TIMEOUT_SECONDS=30
NEUROBRIDGE_API_PREFIX=/api/v1

# LLM provider credentials belong in your client, not in NeuroBridge:
#   export OPENAI_API_KEY=...
#   export ANTHROPIC_API_KEY=...
